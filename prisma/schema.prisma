// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth uses the Credentials provider with JWT sessions (see src/auth.ts) —
// no Account/Session/VerificationToken tables needed. Add them back if OAuth
// providers or email verification are introduced later.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gameSave   GameSave?
  pvpProfile PvpProfile?
}

// Cloud save: mirrors the legacy localStorage blob (state object from game.js),
// stored server-side as JSON. One save per user for now.
model GameSave {
  id        String   @id @default(cuid())
  userId    String   @unique
  stateJson Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Separate from the save blob so leaderboard queries (ORDER BY mmr) stay cheap
// and so PvP resolution has a source of truth that isn't just client state.
model PvpProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  mmr       Int      @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
